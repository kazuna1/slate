<Window x:Class="Slate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slate"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <!-- Glow: a hidden shape behind the bar whose drop shadow is the violet halo.
             Kept separate so the effect doesn't blur the text. -->
        <Border x:Name="GlowLayer"/>

        <Border x:Name="Bar" SnapsToDevicePixels="True">
            <Grid Margin="22,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Prompt" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="PromptShift"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBox x:Name="Input"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FocusVisualStyle="{x:Null}"
                         AcceptsReturn="False"
                         AcceptsTab="False"/>

                <TextBlock x:Name="Placeholder"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="2,0,0,0"
                           IsHitTestVisible="False"/>

                <!-- Completion ghost text and the smooth caret, positioned from the TextBox's caret rect. -->
                <Canvas x:Name="Overlay" Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
                    <TextBlock x:Name="Ghost"/>
                    <Rectangle x:Name="Caret" Width="2" RadiusX="1" RadiusY="1" Opacity="0"/>
                </Canvas>

                <!-- Hotkey hint with a tiny version tag under it, centred together. -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border x:Name="Hint"
                            Padding="9,4"
                            CornerRadius="7"
                            BorderThickness="1">
                        <TextBlock x:Name="HintText" FontSize="12" FontFamily="Segoe UI"/>
                    </Border>
                    <TextBlock x:Name="VersionText"
                               HorizontalAlignment="Right"
                               Margin="0,1,2,0"
                               FontSize="9"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Brief flash when a command is sent. -->
        <Border x:Name="FlashLayer" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Window>
