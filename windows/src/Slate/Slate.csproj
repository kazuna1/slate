<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Slate</AssemblyName>
    <RootNamespace>Slate</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\slate.ico</ApplicationIcon>
    <!-- One version for both platforms: the VERSION file at the repo root. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\..\VERSION').Trim())</Version>
    <!-- WinForms (tray icon only) wants DPI set via its API; WPF needs it in the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Regenerate with windows/tools/make-icon.ps1 -->
    <EmbeddedResource Include="Assets\slate.ico" LogicalName="Slate.ico" />
  </ItemGroup>

</Project>
